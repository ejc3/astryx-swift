 "current": "checkout",
 "screen": {
  "id": "checkout",
  "title": "Checkout",
  "subtitle": "Step 2 of 4: Shipping",
  "toolbar": [
   {
    "kind": "button",
    "id": "checkout.fill",
    "label": "Fill with test data",
    "variant": "ghost",
    "icon": "sparkle"
   }
  ],
  "body": {
   "kind": "stack",
   "axis": "vertical",
   "gap": "lg",
   "children": [
    {
     "kind": "stepper",
     "steps": [
      {
       "label": "Cart",
       "state": "done",
       "selectId": "checkout.goto:0"
      },
      {
       "label": "Shipping",
       "state": "current"
      },
      {
       "label": "Payment",
       "state": "upcoming"
      },
      {
       "label": "Review",
       "state": "upcoming"
      }
     ]
    },
    {
     "kind": "grid",
     "minColumnWidth": 320,
     "gap": "md",
     "children": [
      {
       "kind": "card",
       "title": "Shipping",
       "children": [
        {
         "kind": "textInput",
         "id": "checkout.name",
         "label": "Full name",
         "value": "",
         "placeholder": "Maya Okafor",
         "error": "Enter your name."
        },
        {
         "kind": "textInput",
         "id": "checkout.address",
         "label": "Street address",
         "value": "",
         "placeholder": "1200 Broadway",
         "error": "Enter a street address."
        },
        {
         "kind": "grid",
         "minColumnWidth": 160,
         "gap": "md",
         "children": [
          {
           "kind": "textInput",
           "id": "checkout.city",
           "label": "City",
           "value": "",
           "placeholder": "Oakland",
           "error": "Enter a city."
          },
          {
           "kind": "textInput",
           "id": "checkout.zip",
           "label": "ZIP code",
           "value": "",
           "placeholder": "94612",
           "error": "Enter a ZIP code."
          }
         ]
        },
        {
         "kind": "radio",
         "id": "checkout.shipping",
         "label": "Delivery",
         "value": "standard",
         "options": [
          {
           "value": "standard",
           "label": "Standard · Free",
           "description": "5-7 business days"
          },
          {
           "value": "express",
           "label": "Express · $15.00",
           "description": "2-3 business days"
          },
          {
           "value": "overnight",
           "label": "Overnight · $35.00",
           "description": "Next business day"
          }
         ]
        },
        {
         "kind": "stack",
         "axis": "horizontal",
         "gap": "sm",
         "align": "spread",
         "children": [
          {
           "kind": "button",
           "id": "checkout.back",
           "label": "Back",
           "variant": "secondary",
           "icon": "chevron-left"
          },
          {
           "kind": "button",
           "id": "checkout.next",
           "label": "Continue",
           "variant": "primary",
           "icon": "chevron-right"
          }
         ]
        }
       ]
      },
      {
       "kind": "card",
       "title": "Order summary",
       "children": [
        {
         "kind": "metadata",
         "items": [
          {
           "label": "Subtotal (4 items)",
           "value": "$451.00"
          },
          {
           "label": "Shipping, standard",
           "value": "Free"
          },
          {
           "label": "Tax (9.25%)",
           "value": "$41.72"
          }
         ]
        },
        {
         "kind": "divider"
        },
        {
         "kind": "stack",
         "axis": "horizontal",
         "gap": "sm",
         "align": "spread",
         "children": [
          {
           "kind": "text",
           "text": "Total",
           "style": "emphasis"
          },
          {
           "kind": "text",
           "text": "$492.72",
           "style": "emphasis"
          }
         ]
        },
        {
         "kind": "badge",
         "text": "Free returns on orders over $300",
         "tone": "success"
        }
       ]
      }
     ]
    }
   ]
  }
